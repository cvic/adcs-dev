---
interface Props {
    href: string;
    tabs?: string;
    width?: number;
    height?: number;
    hideCover?: boolean;
    showFacepile?: boolean;
    smallHeader?: boolean;
}

const {
    href,
    tabs = "timeline",
    width = 700,
    height = 700,
    hideCover = false,
    showFacepile = true,
    smallHeader = false,
} = Astro.props;

const params = new URLSearchParams({
    href,
    tabs,
    width: String(width ?? 500), // fallback for SSR
    height: String(height),
    small_header: String(smallHeader),
    adapt_container_width: "true",
    hide_cover: String(hideCover),
    show_facepile: String(showFacepile),
});

const src = `https://www.facebook.com/plugins/page.php?${params}`;
---
<div class="fb-container">
<iframe
        id="fb-iframe"
        data-href={href}
        data-tabs={tabs}
        data-height={height}
        data-small-header={String(smallHeader)}
        data-hide-cover={String(hideCover)}
        data-show-facepile={String(showFacepile)}
        src={src}
        height={height}

></iframe>
</div>

<script is:inline>
    const iframe = document.getElementById("fb-iframe");
    const docWidth = document.body.clientWidth;

    const params = new URLSearchParams({
        href: iframe.dataset.href,
        tabs: iframe.dataset.tabs,
        width: String(docWidth),
        height: iframe.dataset.height,
        small_header: iframe.dataset.smallHeader,
        adapt_container_width: "true",
        hide_cover: iframe.dataset.hideCover,
        show_facepile: iframe.dataset.showFacepile,
    });

    iframe.src = `https://www.facebook.com/plugins/page.php?${params}`;
    iframe.width = String(docWidth);
</script>

<style>
    .fb-container {
        display: flex;
        justify-content: center;
        margin-left:-1rem
    }
</style>